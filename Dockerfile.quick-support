FROM rust@sha256:ee9b9f2ebd8741e4ecf1ade08918e492d642c4e625be481bb7b7954b89e9d504 AS busybox-build
RUN apk add --no-cache build-base linux-headers python3
ADD --checksum=sha256:3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4 https://busybox.net/downloads/busybox-1.37.0.tar.bz2 /src/busybox-1.37.0.tar.bz2
COPY docker/quick-support-busybox /src/patches
WORKDIR /src
RUN tar -xjf busybox-1.37.0.tar.bz2 && cd busybox-1.37.0 && \
    patch -p1 < ../patches/CVE-2025-46394.patch && \
    patch -p1 < ../patches/CVE-2025-46394-2.patch && \
    patch -p1 < ../patches/CVE-2025-60876.patch && \
    make defconfig && sed -i -e 's/# CONFIG_STATIC is not set/CONFIG_STATIC=y/' -e 's/CONFIG_TC=y/# CONFIG_TC is not set/' .config && \
    make -j2 && cp .config /src/patches/build.config
COPY tests/busybox_security.py /src/busybox_security.py
RUN python3 /src/busybox_security.py /src/busybox-1.37.0/busybox

FROM rust@sha256:ee9b9f2ebd8741e4ecf1ade08918e492d642c4e625be481bb7b7954b89e9d504 AS build
RUN apk add --no-cache build-base linux-headers pkgconf libsodium-dev libsodium-static clang-dev openssl-dev openssl-libs-static git perl autoconf automake libtool python3 py3-pip
ENV SODIUM_LIB_DIR=/usr/lib OPENSSL_STATIC=1 CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /work
COPY . .
RUN cargo build --locked --release --bins
RUN python3 -m venv /test-env && /test-env/bin/pip install --no-cache-dir websockets==15.0.1 && /test-env/bin/python tests/run_protocol_tests.py target/release/hbbs

FROM rustdesk/rustdesk-server-s6@sha256:dc099359c4a30611c59f8826bf6eb9780f38d4901470a3901d9eeb21854e0605
# Upstream installs applets as hardlinks. Convert only aliases of its BusyBox
# before replacing the inode, preserving unrelated S6/RustDesk executables.
RUN for path in /bin/* /sbin/* /usr/bin/* /usr/sbin/*; do \
      if [ "$path" != /bin/busybox ] && [ "$path" -ef /bin/busybox ]; then \
        /bin/busybox ln -sf /bin/busybox "$path"; \
      fi; \
    done
COPY --from=build /work/target/release/hbbs /work/target/release/hbbr /work/target/release/rustdesk-utils /usr/bin/
# Replace the inherited multicall binary after every original applet is linked.
COPY --from=busybox-build /src/busybox-1.37.0/busybox /bin/busybox
# Retain complete corresponding BusyBox source, patches and build configuration.
COPY --from=busybox-build /src/busybox-1.37.0.tar.bz2 /usr/share/licenses/busybox/
COPY --from=busybox-build /src/patches /usr/share/licenses/busybox/patches/
COPY --from=busybox-build /src/busybox-1.37.0/LICENSE /usr/share/licenses/busybox/LICENSE
COPY LICENSE /usr/share/licenses/rustdesk-server/LICENSE
LABEL org.opencontainers.image.source="https://github.com/MTG-Thomas/rustdesk-server" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
