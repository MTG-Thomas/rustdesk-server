+    pub enum Variant {
+        Original,
+    }
+    pub fn encode<T: AsRef<[u8]>>(data: T, _variant: Variant) -> String {
+        STANDARD.encode(data)
+    }
+    pub fn decode<T: AsRef<[u8]>>(
+        data: T,
+        _variant: Variant,
+    ) -> Result<Vec<u8>, base64::DecodeError> {
+        STANDARD.decode(data)
+    }
+}
