+/// Preserve the upstream infallible key-generation contract. An unavailable
+/// cryptographic runtime is fatal: never return empty or predictable keys.
+pub fn generate_signing_keypair() -> (
+    libsodium_rs::crypto_sign::PublicKey,
+    libsodium_rs::crypto_sign::SecretKey,
+) {
+    match libsodium_rs::crypto_sign::KeyPair::generate() {
+        Ok(pair) => (pair.public_key, pair.secret_key),
+        Err(_) => {
+            log::error!("Cryptographic key generation failed");
+            std::process::abort();
+        }
+    }
+}
